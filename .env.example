# SmartReco Environment Configuration Template
# -----------------------------------------------------------------------------
# Non-secret application defaults and tuning parameters are stored in config/*.toml.
# Any TOML setting may still be overridden through its existing environment variable.
# Store secrets and deployment-specific values below.
# -----------------------------------------------------------------------------

# Environment (development | production | test)
APP_ENV=development

# Core secrets and storage
SECRET_KEY=
DATABASE_URL=sqlite+aiosqlite:///./smartreco.db

# Mesh API integration
MESH_API_KEY=

# Remote Qdrant (Required only when QDRANT_MODE=remote)
QDRANT_URL=
QDRANT_API_KEY=

# LangSmith tracing (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# Public application URL
APP_BASE_URL=http://127.0.0.1:8001

# Google OAuth (Optional)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Email provider & SMTP (Required only when EMAIL_PROVIDER=smtp)
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional first-admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
