APP_NAME=SmartReco
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite+aiosqlite:///./smartreco.db
MESH_API_KEY=
MESH_BASE_URL=https://api.meshapi.ai/v1
MESH_EMBEDDING_MODEL=openai/text-embedding-3-small
MESH_CHAT_MODEL=
MESH_REQUEST_TIMEOUT_SECONDS=30
MESH_MAX_RETRIES=1
MESH_TOTAL_BUDGET_SECONDS=70
EMBEDDING_SCHEMA_VERSION=1
RELATED_COURSES_ENABLED=true
RELATED_COURSES_LIMIT=2
RELATED_COURSES_CANDIDATE_LIMIT=10
RELATED_COURSES_CACHE_TTL_SECONDS=1800
RELATED_COURSES_SEMANTIC_WEIGHT=0.60
RELATED_COURSES_CATEGORY_WEIGHT=0.20
RELATED_COURSES_TAG_WEIGHT=0.15
RELATED_COURSES_DIFFICULTY_WEIGHT=0.05
RELATED_COURSES_TIMEOUT_SECONDS=3
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=smartreco_courses
VECTOR_SIZE=1536
VECTOR_SYNC_INTERVAL_SECONDS=30
VECTOR_SYNC_BATCH_SIZE=20
VECTOR_SYNC_MAX_ATTEMPTS=5
VECTOR_PROCESSING_TIMEOUT_SECONDS=300
EVENT_BATCH_MAX_SIZE=50
EVENT_METADATA_MAX_BYTES=4096
EVENT_QUEUE_MAX_SIZE=100
SESSION_COOKIE_NAME=smartreco_session
SESSION_HTTPS_ONLY=false
SESSION_MAX_AGE_SECONDS=604800
ADMIN_EMAIL=admin@smartreco.local
ADMIN_PASSWORD=ChangeMe123!
LOG_LEVEL=INFO
RECOMMENDATIONS_ENABLED=true
RECOMMENDATION_EVENT_WINDOW_DAYS=30
RECOMMENDATION_SIGNAL_HALF_LIFE_DAYS=14
RECOMMENDATION_MIN_MEANINGFUL_EVENTS=3
RECOMMENDATION_MIN_SIGNAL_SCORE=6
RECOMMENDATION_COOLDOWN_MINUTES=30
RECOMMENDATION_TTL_HOURS=6
RECOMMENDATION_MAX_CANDIDATES=30
RECOMMENDATION_FINAL_COUNT=3
RECOMMENDATION_MAX_REFINEMENTS=1
RECOMMENDATION_JOB_BATCH_SIZE=10
RECOMMENDATION_LEASE_MINUTES=10
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=smartreco
EMAIL_PROVIDER=console
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=SmartReco
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
APP_BASE_URL=http://127.0.0.1:8001
APP_TIMEZONE=UTC
PAYMENTS_ENABLED=true
PAYMENTS_MODE=demo
CART_MAX_ITEMS=25
DEFAULT_CURRENCY=USD
